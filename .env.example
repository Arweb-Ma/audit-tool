# Public application settings
AUDIT_DOMAIN=audit.example.com
NEXT_PUBLIC_APP_URL=https://audit.example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000
NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Use a unique, long value. Do not commit your real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional: enables Google PageSpeed Insights measurements.
PAGESPEED_API_KEY=

# Request limits and audit behaviour
RATE_LIMIT_AUDITS_PER_HOUR=10
RATE_LIMIT_LEADS_PER_HOUR=5
AUDIT_TIMEOUT_MS=10000
AUDIT_CACHE_TTL_SECONDS=900
